{
	"name": "infersh",
	"version": "0.6.0",
	"module": "src/main.ts",
	"type": "module",
	"private": true,
	"bin": {
		"infer": "src/main.ts"
	},
	"scripts": {
		"start": "bun run src/main.ts",
