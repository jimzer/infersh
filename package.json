	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@biomejs/biome": "^2.5.6",
		"@effect/platform-bun": "^4.0.0-beta.102",
		"@fal-ai/client": "^1.10.1",
		"@readme/openapi-parser": "^6.3.0",
		"effect": "^4.0.0-beta.102",
		"openai": "^7.1.0",
		"openapi3-ts": "^4.6.1"
	}
}
